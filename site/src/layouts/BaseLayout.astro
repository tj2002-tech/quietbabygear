---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = image ? new URL(image, Astro.site).toString() : undefined;
const defaultJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "QuietBabyGear",
    url: "https://quietbabygear.com/",
    description: "QuietBabyGear tests baby gear handling, cleaning, sound, and maintenance friction under sleep-deprived parenting conditions."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "QuietBabyGear",
    url: "https://quietbabygear.com/"
  }
];
const structuredData = jsonLd
  ? [...defaultJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : defaultJsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content={absoluteImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="wrap nav">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">Q</span>
            <span>QuietBabyGear</span>
          </a>
          <nav class="nav-links" aria-label="Primary navigation">
            <a href="/tests/">Tests</a>
            <a href="/methodology/">Methodology</a>
            <a href="/lab-notes/">Lab Notes</a>
            <a href="/about/">About</a>
            <a href="/checklist/">3AM Checklist</a>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="wrap footer-grid">
          <span>QuietBabyGear tests baby gear handling, cleaning, sound, and maintenance friction.</span>
          <span>No medical advice. Some links may be affiliate links.</span>
        </div>
      </footer>
    </div>
  </body>
</html>
