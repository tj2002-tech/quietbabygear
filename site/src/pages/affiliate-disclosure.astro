---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Affiliate Disclosure | QuietBabyGear";
const description = "QuietBabyGear affiliate disclosure and editorial independence policy.";
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <p class="eyebrow">Disclosure</p>
    <h1>Affiliate Disclosure</h1>
    <p>Some links on QuietBabyGear may be affiliate links. If you buy through those links, we may earn a commission at no additional cost to you.</p>
    <p>Our testing notes, tables, scores, and product criticisms are based on our own handling tests and observations. Affiliate relationships do not guarantee positive coverage.</p>
    <p>QuietBabyGear does not provide medical advice, diagnosis, or treatment guidance.</p>
  </article>
</BaseLayout>

