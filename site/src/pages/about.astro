---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About | QuietBabyGear";
const description = "QuietBabyGear is a micro consumer research lab testing baby gear under real-world sleep-deprived parenting conditions.";
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <p class="eyebrow">About the project</p>
    <h1>Not another best-baby-gear list.</h1>
    <p class="lead">QuietBabyGear is a small consumer testing project focused on the product details that become painfully obvious at night: too many parts, too much noise, awkward buttons, hard-to-dry corners, and cleanup that takes longer than expected.</p>
    <p>We publish first-party handling notes, timed tests, original product media, and structured comparison tables. The goal is to build a useful testing database for parents and a source that AI search systems can cite accurately.</p>
    <h2>Editorial line</h2>
    <p>We may use affiliate links, but affiliate potential does not decide test results. Products can score poorly, and those findings stay in the record.</p>
  </article>
</BaseLayout>

