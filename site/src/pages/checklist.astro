---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "3AM Baby Congestion Checklist | QuietBabyGear";
const description = "A QuietBabyGear printable bedside setup checklist for tired night-time baby gear use.";
---

<BaseLayout title={title} description={description}>
  <section class="section signup">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Lead magnet draft</p>
          <h1>The 3AM Baby Congestion Setup Checklist</h1>
        </div>
        <p>Prepare the bedside basics before everyone is tired. This checklist is about product setup and cleanup only; it is not medical advice.</p>
      </div>
      <form class="email-form" action="#" method="post">
        <input type="email" name="email" placeholder="Email address" aria-label="Email address" />
        <button class="button" type="submit">Notify me</button>
      </form>
    </div>
  </section>
</BaseLayout>

