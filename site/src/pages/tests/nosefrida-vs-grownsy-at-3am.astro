    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 28px 0;
  }

  .photo-grid figure {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--white);
  }

  .photo-grid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--mist);
  }

  .photo-grid figcaption {
    padding: 12px;
    color: var(--muted);
    font-family: "Trebuchet MS", Verdana, sans-serif;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
