const description = "QuietBabyGear's first-party NoseFrida cleaning reset notes: what parts need rinsing, what happens to the disposable filter, and why reset is fast but not friction-free.";
const image = "/images/tests/nosefrida-vs-grownsy/nosefrida-04-bedside.jpg";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "NoseFrida Cleaning Reset: What Actually Needs to Be Rinsed?",
    description,
    image: `https://quietbabygear.com${image}`,
    datePublished: "2026-07-12",
    dateModified: "2026-07-12",
    author: {
      "@type": "Organization",
      name: "QuietBabyGear"
    },
    publisher: {
      "@type": "Organization",
      name: "QuietBabyGear"
    },
