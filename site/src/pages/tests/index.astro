---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Baby Gear Tests | QuietBabyGear";
const description = "QuietBabyGear baby gear testing results, protocols, and comparison articles.";
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Testing archive</p>
          <h1>Tests</h1>
        </div>
        <p>Each test page is structured around first-party data, original media, and repeated-use notes.</p>
      </div>
      <div class="article-list">
        <a class="article-row" href="/tests/grownsy-warning-card-backflow-chamber-drying/">
          <span class="tag">Grownsy</span>
          <div>
            <h3>Grownsy Warning Card Notes</h3>
            <p>Backflow, chamber capacity, drying, charging, and the hidden cleanup friction inside the box.</p>
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
        <a class="article-row" href="/tests/nosefrida-vs-grownsy-at-3am/">
          <span class="tag">Pilot</span>
          <div>
            <h3>NoseFrida vs Grownsy at 3AM</h3>
            <p>A first-round manual-vs-electric pilot test using original product photos and cleanup friction notes.</p>
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
        <a class="article-row" href="/tests/easiest-baby-nasal-aspirator-to-clean-at-3am/">
          <span class="tag">MCT</span>
          <div>
            <h3>Easiest Baby Nasal Aspirator to Clean at 3AM</h3>
            <p>Draft article shell ready for product data, stopwatch photos, and cleanup observations.</p>
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
