---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy | QuietBabyGear";
const description = "QuietBabyGear privacy policy.";
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <p class="eyebrow">Policy draft</p>
    <h1>Privacy Policy</h1>
    <p>QuietBabyGear may collect basic analytics data and email addresses submitted through signup forms. We use this information to understand site performance and send requested updates.</p>
    <p>We do not sell personal information. Email subscribers can unsubscribe from future messages through the link provided in each email.</p>
    <p>This draft should be reviewed before broad public launch.</p>
  </article>
</BaseLayout>

